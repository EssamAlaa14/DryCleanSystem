@using Domain.Enums
@model WebApp.ViewModels.CreateOrderViewModel;

<section class="section">
    <h2>إضافة طلب جديد</h2>

    <form action="javascript:void(0)">
        @Html.AntiForgeryToken()
        <div class="row">
            <div class="col-12">
                <h4 class="fw-bold text-decoration-underline">تفاصيل الطلب</h4>
            </div>
            <div class="col-3">
                <div class="form-group">
                    <label class="h6 mb-2 text-primary">نوع الطلب</label>
                    <div class="d-flex flex-column align-items-start justify-content-center">
                        @foreach (var orderType in Enum.GetValues(typeof(OrderType)).Cast<OrderType>())
                        {
                            <label class="h6">
                                <input type="radio" name="Command.Order.OrderType" value="@((int)orderType)" />
                                @orderType.GetDisplayName()
                            </label>
                        }
                    </div>
                </div>
            </div>
            <div class="col-4">
                <div class="form-group w-50">
                    <label class="h6 mb-2 text-primary" asp-for="Command.Order.DeliveryDate">تاريخ التسليم المتوقع</label>
                    <input asp-for="Command.Order.DeliveryDate" class="form-control" type="date" />
                </div>
                <div class="separator"></div>
                <div class="form-group">
                    <label class="h6 mb-2 text-primary" asp-for="Command.Order.Notes">إضافة ملاحظات</label>
                    <textarea asp-for="Command.Order.Notes" placeholder="ملاحظات" rows="4" class="form-control"></textarea>
                </div>
            </div>
        </div>
        <hr />
        <div class="row">
            <div class="col-3">
                <div class="form-group">
                    <label class="h5 mb-2 text-primary">
                        بيانات العميل
                    </label>
                    <div class="d-flex align-items-center justify-content-start">
                        <label class="h6">
                            <input type="radio" name="Order.CustomerType" checked value="2" onchange="toggleNewCustomerForm()" />
                            حالي
                        </label>
                        <label class="px-3 h6">
                            <input type="radio" name="Order.CustomerType" value="1" onchange="toggleNewCustomerForm()" />
                            جديد
                        </label>
                    </div>
                </div>
            </div>
            <div class="col-12">
                <div id="existingCustomer" class="row">
                    <div class="col-3">
                        <div class="form-group">
                            <label class="h6 mb-2 text-primary" for="customerSearch">بحث</label>
                            <input type="search"
                                   id="customerSearch"
                                   class="form-control"
                                   placeholder="بحث بالاسم أو برقم الهاتف"
                                   onkeyup="filterCustomers();" />
                        </div>
                    </div>

                    <div class="col-7">
                        <div class="form-group">
                            <label class="h6 mb-2 text-primary" for="Command_SelectedCustomerId">إختيار العميل من قائمة العملاء السابقين</label>
                            <select asp-for="Command.SelectedCustomerId" class="form-control" onchange="toggleNewCustomerForm()">
                                <option value="">-- إختر عميل --</option>
                                @foreach (var customer in Model.OrderListItemsModel!.Customers)
                                {
                                    <option value="@customer.Id">@customer.Name (@customer.PrimaryPhone)</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>

                <div id="newCustomerForm" class="row d-none">
                    <div class="col-4">
                        <div class="form-group">
                            <label class="h6 mb-2 text-primary" asp-for="Command.NewCustomer!.Name"> الاسم </label>
                            <input asp-for="Command.NewCustomer!.Name" class="form-control" placeholder="اسم العميل" />
                            <span asp-validation-for="Command.NewCustomer!.Name" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="form-group">
                            <label class="h6 mb-2 text-primary" asp-for="Command.NewCustomer!.PrimaryPhone">رقم الهاتف</label>
                            <input asp-for="Command.NewCustomer!.PrimaryPhone" class="form-control" placeholder="رقم الهاتف" />
                            <span asp-validation-for="Command.NewCustomer!.PrimaryPhone" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="form-group">
                            <label class="h6 mb-2 text-primary" asp-for="Command.NewCustomer!.SecondaryPhone">رقم هاتف اخر</label>
                            <input asp-for="Command.NewCustomer!.SecondaryPhone" class="form-control" placeholder="رقم هاتف اخر" />
                        </div>
                    </div>
                    <div class="col-2">
                        <div class="form-group">
                            <label class="h6 mb-2 text-primary" asp-for="Command.NewCustomer!.District">المنطقة</label>
                            <input asp-for="Command.NewCustomer!.District" class="form-control" placeholder="المنطقة" />
                            <span asp-validation-for="Command.NewCustomer!.District" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="form-group">
                            <label class="h6 mb-2 text-primary" asp-for="Command.NewCustomer!.Street">الشارع</label>
                            <input asp-for="Command.NewCustomer!.Street" class="form-control" placeholder="الشارع" />
                            <span asp-validation-for="Command.NewCustomer!.Street" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="form-group">
                            <label class="h6 mb-2 text-primary" asp-for="Command.NewCustomer!.BuildingName">اسم أو رقم المبنى/البرج</label>
                            <input asp-for="Command.NewCustomer!.BuildingName" class="form-control" placeholder="اسم أو رقم المبنى/البرج" />
                            <span asp-validation-for="Command.NewCustomer!.BuildingName" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-3">
                        <div class="form-group">
                            <label class="h6 mb-2 text-primary" asp-for="Command.NewCustomer!.FloorNumber">الدور</label>
                            <select asp-for="Command.NewCustomer!.FloorNumber" class="form-control">
                                <option value="">-- إختر الدور --</option>
                                @for (var i = 0; i < 18; i++)
                                {
                                    <option value="@i">@i</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-3">
                        <div class="form-group">
                            <label class="h6 mb-2 text-primary" asp-for="Command.NewCustomer!.ApartmentNumber">رقم الشقة/اسم الشقة</label>
                            <input asp-for="Command.NewCustomer!.ApartmentNumber" class="form-control" placeholder="رقم الشقة/اسم الشقة" />
                            <span asp-validation-for="Command.NewCustomer!.ApartmentNumber" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <hr />
        <div class="row">
            <div class="col-12">
                <div class="d-flex align-items-center justify-content-between">
                    <h4 class="fw-bold text-decoration-underline">عناصر الطلب</h4>
                    <button type="button" class="btn btn-success" onclick="addOrderItem()">إضافة عنصر للطلب</button>
                </div>
            </div>
            <div class="col-12">
                <div id="orderItemsContainer">
                </div>
            </div>
        </div>
        <div class="row justify-content-center mt-3">
            <div class="col-4">
                <button type="submit" onclick="submitForm()" class="btn btn-primary w-100">إضافة الطلب</button>
            </div>
        </div>
    </form>
</section>

<template id="orderItemTemplate" class="d-none">
    <div class="row" id="orderItem_{{orderItemIndex}}">
        <div class="col-1">
            <span class="h6 text-primary">#{{orderItemNumber}}</span>
        </div>
        <div class="col-2">
            <div class="form-group">
                <label class="h6 mb-2 text-primary" for="Items_{{orderItemIndex}}__PieceId">القطعة</label>
                <select id="Items_{{orderItemIndex}}__PieceId" class="form-control">
                    <option value="">-- إختر القطعة --</option>
                    @foreach (var piece in Model.OrderListItemsModel.Pieces)
                    {
                        <option value="@piece.Id">@piece.Name</option>
                    }
                </select>
            </div>
        </div>
        <div class="col-3">
            <div class="form-group">
                <label class="h6 mb-2 text-primary" for="Items_{{orderItemIndex}}__Description">الوصف</label>
                <input id="Items_{{orderItemIndex}}__Description" name="Items[{{orderItemIndex}}].Description" class="form-control" />
            </div>
        </div>
        <div class="col-2">
            <div class="form-group">
                <label class="h6 mb-2 text-primary" for="Items_{{orderItemIndex}}__Quantity">الكمية</label>
                <input id="Items_{{orderItemIndex}}__Quantity" name="Items[{{orderItemIndex}}].Quantity" class="form-control" />
            </div>
        </div>
        <div class="col-2">
            <div class="form-group">
                <label class="h6 mb-2 text-primary" for="Items_{{orderItemIndex}}__SingleQuantityPrice">سعر القطعة</label>
                <input id="Items_{{orderItemIndex}}__SingleQuantityPrice" name="Items[{{orderItemIndex}}].SingleQuantityPrice" class="form-control" />
            </div>
        </div>
        <div class="col-2">
            <div class="form-group">
                <label class="h6 mb-2 text-primary" for="Items_{{orderItemIndex}}__Color">اللون</label>
                <input id="Items_{{orderItemIndex}}__Color" name="Items[{{orderItemIndex}}].Color" class="form-control" />
            </div>
        </div>
        <div class="col-4">
            <div class="form-group">
                <label class="h6 mb-2 text-primary">المطلوب؟</label>
                <div class="d-flex align-items-start justify-content-center">
                    @foreach (var cleaningOption in Model.OrderListItemsModel.CleaningTypeOptions)
                    {
                        <label class="h6 px-3">
                            <input type="checkbox" name="Items[{{orderItemIndex}}].CleaningTypeOption" value="@(cleaningOption.Id)" />
                            @cleaningOption.Name
                        </label>
                    }
                </div>
            </div>
        </div>
        <div class="col-4">
            <div class="form-group">
                <label class="h6 mb-2 text-primary" for="Items_{{orderItemIndex}}__Comment">إضافة تعليق</label>
                <input id="Items_{{orderItemIndex}}__Comment" name="Items[{{orderItemIndex}}].Comment" class="form-control" />
            </div>
        </div>
        <div class="col-3">
            <div class="form-group">
                <button type="button" class="btn btn-danger mt-4 remove-item-btn" data-index="{{orderItemIndex}}">حذف</button>
            </div>
        </div>
    </div>
    <hr />
</template>