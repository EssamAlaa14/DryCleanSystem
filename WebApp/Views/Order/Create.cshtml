@using Domain.Enums
@model WebApp.ViewModels.CreateOrderViewModel;

<section class="section">
    <h2>إضافة طلب جديد</h2>
    <form action="javascript:void(0)" id="createOrderForm">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Command.Order.OrderType" value="@((int)Model.Command.Order.OrderType)" />
        <div class="row">
            <div class="col-3">
                <div class="form-group">
                    <label class="h5 mb-2 text-primary">
                        بيانات العميل
                    </label>
                    <div class="d-flex align-items-center justify-content-start">
                        <label class="h6">
                            <input type="radio" name="Order.CustomerType" checked value="2" onchange="toggleNewCustomerForm()" />
                            حالي
                        </label>
                        <label class="px-3 h6">
                            <input type="radio" name="Order.CustomerType" value="1" onchange="toggleNewCustomerForm()" />
                            جديد
                        </label>
                    </div>
                </div>
            </div>
            <div class="col-12">
                <div id="existingCustomer" class="row">
                    <div class="col-3">
                        <div class="form-group">
                            <label class="h6 mb-2 text-primary" for="customerSearch">بحث</label>
                            <input type="search"
                                   id="customerSearch"
                                   class="form-control"
                                   placeholder="بحث بالاسم أو برقم الهاتف"
                                   onkeyup="filterCustomers();" />
                        </div>
                    </div>
                    <div class="col-3">
                        <div class="form-group">
                            <label class="h6 mb-2 text-primary" for="Command_SelectedCustomerId">
                                إختيار العميل من قائمة العملاء السابقين
                                <sup class="text-danger">*</sup>
                            </label>
                            <select asp-for="Command.SelectedCustomerId" class="form-select" onchange="toggleNewCustomerForm(this)">
                                <option value="">-- إختر عميل --</option>
                                @foreach (var customer in Model.OrderListItemsModel!.Customers)
                                {
                                    <option value="@customer.Id">@customer.Name (@customer.PrimaryPhone)</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-6 d-none" id="addressList">
                        <div class="form-group">
                            <label class="h6 mb-2 text-primary" for="Command_SelectedAddressId">إختيار العنوان</label>
                            <select asp-for="Command.SelectedAddressId" class="form-select">
                                <option value="">-- إختر عنوان العميل --</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div id="newCustomerForm" class="row d-none">
                    <div class="col-12">
                        <h4 class="form-title text-bg-primary text-white mb-2">بيانات العميل</h4>
                    </div>
                    <div class="col-4">
                        <div class="form-group">
                            <label class="h6 mb-2 text-primary" asp-for="Command.NewCustomer!.Name">
                                الاسم
                                <sup class="text-danger">*</sup>
                            </label>
                            <input data-required="true" asp-for="Command.NewCustomer!.Name" class="form-control" placeholder="اسم العميل" />
                            <span asp-validation-for="Command.NewCustomer!.Name" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="form-group">
                            <label class="h6 mb-2 text-primary" asp-for="Command.NewCustomer!.PrimaryPhone">
                                رقم الهاتف
                                <sup class="text-danger">*</sup>
                            </label>
                            <input data-required="true" asp-for="Command.NewCustomer!.PrimaryPhone" class="form-control" placeholder="رقم الهاتف" />
                            <span asp-validation-for="Command.NewCustomer!.PrimaryPhone" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="form-group">
                            <label class="h6 mb-2 text-primary" asp-for="Command.NewCustomer!.SecondaryPhone">رقم هاتف اخر</label>
                            <input asp-for="Command.NewCustomer!.SecondaryPhone" class="form-control" placeholder="رقم هاتف اخر" />
                        </div>
                    </div>
                </div>
                <div id="newAddressForm" class="row d-none">
                    <div class="col-12">
                        <h4 class="form-title text-bg-success text-white my-2">تفاصيل العنوان</h4>
                    </div>
                    <div class="col-2">
                        <div class="form-group">
                            <label class="h6 mb-2 text-primary" asp-for="Command.NewAddress!.DistrictId">
                                المنطقة
                                <sup class="text-danger">*</sup>
                            </label>
                            <select data-required="true" asp-for="Command.NewAddress!.DistrictId" class="form-select">
                                <option value="">-- إختر المنطقة --</option>
                                @foreach (var district in Model.OrderListItemsModel!.Districts)
                                {
                                    <option value="@district.Id">@district.Name</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="form-group">
                            <label class="h6 mb-2 text-primary" asp-for="Command.NewAddress!.Street">
                                الشارع
                                <sup class="text-danger">*</sup>
                            </label>
                            <input data-required="true" asp-for="Command.NewAddress!.Street" class="form-control" placeholder="الشارع" />
                            <span asp-validation-for="Command.NewAddress!.Street" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="form-group">
                            <label class="h6 mb-2 text-primary" asp-for="Command.NewAddress!.BuildingName">
                                اسم أو رقم المبنى/البرج
                                <sup class="text-danger">*</sup>
                            </label>
                            <input data-required="true" asp-for="Command.NewAddress!.BuildingName" class="form-control" placeholder="اسم أو رقم المبنى/البرج" />
                            <span asp-validation-for="Command.NewAddress!.BuildingName" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-3">
                        <div class="form-group">
                            <label class="h6 mb-2 text-primary" asp-for="Command.NewAddress!.FloorNumber">
                                الدور
                                <sup class="text-danger">*</sup>
                            </label>
                            <select data-required="true" asp-for="Command.NewAddress!.FloorNumber" class="form-select">
                                <option value="">-- إختر الدور --</option>
                                @for (var i = 0; i < 18; i++)
                                {
                                    <option value="@i">@i</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-3">
                        <div class="form-group">
                            <label class="h6 mb-2 text-primary" asp-for="Command.NewAddress!.ApartmentNumber">
                                رقم الشقة/اسم الشقة
                                <sup class="text-danger">*</sup>
                            </label>
                            <input data-required="true" asp-for="Command.NewAddress!.ApartmentNumber" class="form-control" placeholder="رقم الشقة/اسم الشقة" />
                            <span asp-validation-for="Command.NewAddress!.ApartmentNumber" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <hr />
        <div class="row">
            <div class="col-12">
                <div class="d-flex align-items-center justify-content-between">
                    <h4 class="fw-bold text-decoration-underline">عناصر الطلب</h4>
                    <button type="button" class="btn btn-success" onclick="addOrderItem()">إضافة عنصر للطلب</button>
                </div>
            </div>
            <div class="col-12">
                <div id="orderItemsContainer">
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-12">
                <h4 class="fw-bold text-decoration-underline">تفاصيل الطلب</h4>
            </div>
            <div class="col-2">
                <div id="orderSummaryContainer">
                </div>
            </div>
            <div class="col-2">
                <div class="form-group">
                    <label class="h6 mb-2 text-primary" asp-for="Command.Order.DeliveryFees">رسوم التوصيل</label>
                    <input type="number" min="0" value="0" asp-for="Command.Order.DeliveryFees" class="form-control" />
                </div>
            </div>
            <div class="col-6">
                <div class="form-group">
                    <label class="h6 mb-2 text-primary" asp-for="Command.Order.Notes">إضافة ملاحظات</label>
                    <textarea asp-for="Command.Order.Notes" placeholder="ملاحظات" rows="2" class="form-control"></textarea>
                </div>
            </div>
        </div>
        <hr />
        <div class="row justify-content-center mt-3">
            <div class="col-4">
                <button type="submit" onclick="submitForm()" class="btn btn-primary w-100">إضافة الطلب</button>
            </div>
        </div>
    </form>
</section>

<template id="orderItemTemplate" class="d-none">
    <div class="row order-item" id="orderItem_{{orderItemIndex}}">
        <div class="col-11">
            <div class="row">
                <div class="col-2">
                    <div class="form-group">
                        <label class="h6 mb-2 text-danger" for="Items_{{orderItemIndex}}__PieceId">
                            القطعة
                            <sup class="text-danger">*</sup>
                        </label>
                        <select id="Items_{{orderItemIndex}}__PieceId" class="form-select" required>
                            <option value="">-- إختر القطعة --</option>
                            @foreach (var piece in Model.OrderListItemsModel.Pieces)
                            {
                                <option value="@piece.Id">@piece.Name</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="col-1">
                    <div class="form-group">
                        <label class="h6 mb-2 text-danger" for="Items_{{orderItemIndex}}__Quantity">
                            الكمية
                            <sup class="text-danger">*</sup>
                        </label>
                        <select id="Items_{{orderItemIndex}}__Quantity" name="Items[{{orderItemIndex}}].Quantity" class="form-select" required>
                            <option value="1" selected>1</option>
                            @for (var i = 2; i <= (Model.Command.Order.OrderType == OrderType.Clothes ? 100 : 10); i++)
                            {
                                <option value="@i">@i</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="col-4">
                    <div class="form-group">
                        <label class="h6 mb-2 text-primary" for="Items_{{orderItemIndex}}__Description">
                            @(Model.Command.Order.OrderType == OrderType.Rugs ? "الوصف/المقاس" : "الوصف")
                            <sup class="text-danger">*</sup>
                        </label>
                        <input id="Items_{{orderItemIndex}}__Description" name="Items[{{orderItemIndex}}].Description" class="form-control" required />
                    </div>
                </div>
                @if (Model.Command.Order.OrderType == OrderType.Clothes)
                {
                    <div class="col-2">
                        <div class="form-group">
                            <label class="h6 mb-2 text-primary">
                                المطلوب؟
                                <sup class="text-danger">*</sup>
                            </label>
                            <div class="d-flex flex-column align-items-start justify-content-center">
                                @foreach (var cleaningOption in Model.OrderListItemsModel.CleaningTypeOptions)
                                {
                                    <label class="h6 px-3">
                                        <input type="checkbox" name="Items[{{orderItemIndex}}].CleaningTypeOption" value="@(cleaningOption.Id)" />
                                        @cleaningOption.Name
                                    </label>
                                }
                            </div>
                        </div>
                    </div>
                }
                <div class="col-2">
                    <div class="form-group">
                        <label class="h6 mb-2 text-primary" for="Items_{{orderItemIndex}}__SingleQuantityPrice">
                            سعر القطعة
                            <sup class="text-danger">*</sup>
                        </label>
                        <input type="number" min="0" value="0" id="Items_{{orderItemIndex}}__SingleQuantityPrice" 
                            name="Items[{{orderItemIndex}}].SingleQuantityPrice" class="form-control" required />
                    </div>
                    <div class="form-group">
                        <label class="h6 mb-2 text-primary" for="Items_{{orderItemIndex}}__TotalItemPrice">
                            السعر الكلي
                        </label>
                        <input class="form-control text-danger" type="text" disabled id="Items_{{orderItemIndex}}__TotalItemPrice" value="0" />
                    </div>
                </div>
            </div>
        </div>
        <div class="col-1">
            <div class="form-group">
                <button type="button" class="btn btn-danger mt-4 remove-item-btn d-none" data-index="{{orderItemIndex}}">حذف</button>
            </div>
        </div>
        <div class="col-12"><hr /></div>
    </div>
</template>
<template id="orderSummaryTemplate" class="d-none">
    <div class="row">
        <div class="col-12">
            <div class="">
                <span class="h6 mb-2 text-primary">عدد العناصر:</span>
                <span class="fw-bold">
                    <span id="totalQuantity">{{totalQuantity}}</span>
                </span>
            </div>
        </div>
        <div class="col-12">
            <div class="">
                <span class="h6 mb-2 text-primary">السعر الإجمالي:</span>
                <span class="fw-bold">
                    <span id="totalPrice">{{totalPrice}}</span> جنيه
                </span>
            </div>
        </div>
    </div>
</template>

@section Scripts {
    <script src="~/js/create-order.js" asp-append-version="true"></script>
}