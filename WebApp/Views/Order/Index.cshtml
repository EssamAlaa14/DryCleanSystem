@model IEnumerable<Application.Common.DTOs.InfoDtos.OrderDto>;

<table>
    <thead>
        <tr>
            <th>Order Id</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var order in Model)
        {
            <tr>
                <td>@order.Id</td>
            </tr>
        }
    </tbody>
</table>