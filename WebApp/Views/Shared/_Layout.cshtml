<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - الصفوة</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/dataTables/css/datatables.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site-ar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WebApp.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">دراي كلين الصفوة</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">الرئيسية</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-danger fw-bold" href="/orders">قائمة الطلبات</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-primary fw-bold" href="/order/create/@((int)Domain.Enums.OrderType.Clothes)">
                                إضافة طلب ملابس
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-info fw-bold" href="/order/create/@((int)Domain.Enums.OrderType.Linens)">
                                إضافة طلب مفروشات
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-success fw-bold" href="/order/create/@((int)Domain.Enums.OrderType.Rugs)">
                                إضافة طلب سجاد
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <main role="main" class="pb-3">
        <div class="container">
            @RenderBody()
        </div>
    </main>
    <footer class="border-top footer">
        <div class="container">
            <div class="d-flex justify-content-between align-items-center">
                <p class="text-primary-emphasis">&copy; 2025 - دراي كلين الصفوة</p>
                <p class="fw-bold text-primary-emphasis">إدارة الحاج/ إبراهيم الونش</p>
            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/dataTables/js/datatables.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
